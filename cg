#!/bin/zsh
# Short commands for local development. Run from the repo root: ./cg <command>
#   ./cg admin        admin panel (http://127.0.0.1:7370)
#   ./cg nakama       rebuild the server code and restart Nakama
#   ./cg web-build    WebGL build into client/Builds/Web (Unity must be closed)
#   ./cg web          serve the web build (http://localhost:8080)
#   ./cg dashboard    developer dashboard (http://127.0.0.1:7360)
#   ./cg agents up    planner / developer / tester agents in tmux + agent dashboard (attach, status, stop, down)
#   ./cg agents-dash  only the agent dashboard (http://127.0.0.1:7380)
#   ./cg testbed      the shared Unity test folder (setup, run <branch>, status)
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

unity_bin() {
  local version
  version=$(grep m_EditorVersion: client/ProjectSettings/ProjectVersion.txt | awk '{print $2}')
  echo "/Applications/Unity/Hub/Editor/$version/Unity.app/Contents/MacOS/Unity"
}

case "$1" in
  admin)
    cd tools/admin
    [ -d node_modules ] || npm install
    (sleep 3 && open http://127.0.0.1:7370) &
    npm run dev
    ;;
  nakama)
    docker compose up -d --force-recreate server-build nakama
    echo "Nakama yeniden başladı. Konsol: http://localhost:7351"
    ;;
  web-build)
    UNITY=$(unity_bin)
    if [ ! -x "$UNITY" ]; then echo "Unity bulunamadı: $UNITY"; exit 1; fi
    if [ -f client/Temp/UnityLockfile ] && lsof client/Temp/UnityLockfile >/dev/null 2>&1; then
      echo "Unity bu projede açık. Unity'de CollectionGame > Build Web menüsünü kullan ya da Unity'yi kapatıp tekrar dene."
      exit 1
    fi
    echo "Web build alınıyor (birkaç dakika sürebilir), log: client/Logs/web-build.log"
    "$UNITY" -batchmode -quit -projectPath client -executeMethod CollectionGame.EditorTools.BuildTools.BuildWeb -logFile client/Logs/web-build.log
    grep "\[Build\]" client/Logs/web-build.log | tail -1
    ;;
  web)
    if [ ! -f client/Builds/Web/index.html ]; then echo "Web build yok. Önce: ./cg web-build"; exit 1; fi
    (sleep 1 && open http://localhost:8080) &
    cd client/Builds/Web && python3 -m http.server 8080
    ;;
  dashboard)
    (sleep 1 && open http://127.0.0.1:7360) &
    node tools/dev-dashboard/serve.mjs
    ;;
  agents)
    shift
    exec bash tools/agents/agents.sh "$@"
    ;;
  agents-dash)
    (sleep 1 && open http://127.0.0.1:7380) &
    node tools/agents/dashboard/serve.mjs
    ;;
  testbed)
    shift
    exec bash tools/agents/testbed.sh "$@"
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
