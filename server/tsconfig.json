{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2017"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules"],
    "types": ["nakama-runtime"]
  },
  "include": ["src/**/*.ts"]
}
